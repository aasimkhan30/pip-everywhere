<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PiPEverywhere.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#333333" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9D9D9D" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#6E6E6E" />
        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#094771" />
        <SolidColorBrush x:Key="StatusBorderBrush" Color="#1668A6" />
        <SolidColorBrush x:Key="StatusEnabledTextBrush" Color="#BCD6EA" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#89D185" />
        <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#3A1F1F" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#F0A6A6" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="680" Padding="28,24,28,28" Spacing="24">
            <Border
                x:Name="StatusCard"
                Padding="16,14"
                HorizontalAlignment="Stretch"
                Background="{StaticResource StatusBackgroundBrush}"
                BorderBrush="{StaticResource StatusBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="StatusIconCircle"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Background="{StaticResource SuccessBrush}"
                        CornerRadius="12">
                        <FontIcon
                            x:Name="StatusIcon"
                            FontSize="13"
                            Foreground="#12291A"
                            Glyph="&#xE73E;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="StatusTitle"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="PiP Everywhere is running" />
                        <TextBlock
                            x:Name="StatusSubtitle"
                            FontSize="12"
                            Foreground="{StaticResource StatusEnabledTextBrush}"
                            Text="Watching 1 browser for video" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="EnabledToggle"
                        Grid.Column="2"
                        MinWidth="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="OnEnabledToggled" />
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock
                    CharacterSpacing="40"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="STARTUP" />
                <Border
                    x:Name="StartupCard"
                    Padding="14,12"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="Medium" Text="Start automatically when I sign in" />
                            <TextBlock
                                x:Name="StartupDescription"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="Launches the watcher in the background at sign-in."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Grid.Column="1"
                            MinWidth="40"
                            HorizontalAlignment="Right"
                            OffContent=""
                            OnContent=""
                            Toggled="OnStartupToggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock
                        CharacterSpacing="40"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="BROWSERS" />
                    <TextBlock
                        x:Name="SelectedCountText"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{StaticResource DimTextBrush}"
                        Text="1 selected" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Choose which browsers should keep PiP visible on every desktop."
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="BrowserFilter"
                    Height="34"
                    Padding="10,5"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    CornerRadius="4"
                    FontSize="12"
                    PlaceholderText="Filter browsers"
                    TextChanged="OnBrowserFilterChanged" />

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <Grid x:Name="EdgeRow" Padding="14,9" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="EdgeCheckBox"
                                Checked="OnBrowserSelectionChanged"
                                Content="Microsoft Edge"
                                Tag="edge"
                                Unchecked="OnBrowserSelectionChanged" />
                            <TextBlock
                                x:Name="EdgeDetection"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DimTextBrush}"
                                Text="not detected" />
                        </Grid>
                        <Rectangle x:Name="EdgeSeparator" Height="1" Fill="{StaticResource SubtleBorderBrush}" />

                        <Grid x:Name="ChromeRow" Padding="14,9" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="ChromeCheckBox"
                                Checked="OnBrowserSelectionChanged"
                                Content="Google Chrome"
                                Tag="chrome"
                                Unchecked="OnBrowserSelectionChanged" />
                            <TextBlock
                                x:Name="ChromeDetection"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DimTextBrush}"
                                Text="not detected" />
                        </Grid>
                        <Rectangle x:Name="ChromeSeparator" Height="1" Fill="{StaticResource SubtleBorderBrush}" />

                        <Grid x:Name="FirefoxRow" Padding="14,9" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="FirefoxCheckBox"
                                Checked="OnBrowserSelectionChanged"
                                Content="Mozilla Firefox"
                                Tag="firefox"
                                Unchecked="OnBrowserSelectionChanged" />
                            <TextBlock
                                x:Name="FirefoxDetection"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DimTextBrush}"
                                Text="not detected" />
                        </Grid>
                        <Rectangle x:Name="FirefoxSeparator" Height="1" Fill="{StaticResource SubtleBorderBrush}" />

                        <Grid x:Name="BraveRow" Padding="14,9" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="BraveCheckBox"
                                Checked="OnBrowserSelectionChanged"
                                Content="Brave"
                                Tag="brave"
                                Unchecked="OnBrowserSelectionChanged" />
                            <TextBlock
                                x:Name="BraveDetection"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DimTextBrush}"
                                Text="not detected" />
                        </Grid>
                        <Rectangle x:Name="BraveSeparator" Height="1" Fill="{StaticResource SubtleBorderBrush}" />

                        <Grid x:Name="OperaRow" Padding="14,9" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="OperaCheckBox"
                                Checked="OnBrowserSelectionChanged"
                                Content="Opera"
                                Tag="opera"
                                Unchecked="OnBrowserSelectionChanged" />
                            <TextBlock
                                x:Name="OperaDetection"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DimTextBrush}"
                                Text="not detected" />
                        </Grid>
                        <Rectangle x:Name="OperaSeparator" Height="1" Fill="{StaticResource SubtleBorderBrush}" />

                        <Grid x:Name="VivaldiRow" Padding="14,9" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="VivaldiCheckBox"
                                Checked="OnBrowserSelectionChanged"
                                Content="Vivaldi"
                                Tag="vivaldi"
                                Unchecked="OnBrowserSelectionChanged" />
                            <TextBlock
                                x:Name="VivaldiDetection"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DimTextBrush}"
                                Text="not detected" />
                        </Grid>

                        <TextBlock
                            x:Name="NoBrowsersMessage"
                            Padding="14"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource DimTextBrush}"
                            Text="No browsers match"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Padding="14,12"
                Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        FontSize="15"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE946;" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="Runs locally. " />
                        <Run Text="Reads window titles and process names only. Never accesses browser tabs, history, or page content." />
                    </TextBlock>
                </Grid>
            </Border>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    Padding="16,7"
                    Click="OnHideToTrayClicked"
                    Content="Hide to tray" />
                <Button
                    Grid.Column="2"
                    Padding="16,7"
                    Background="{StaticResource DangerBackgroundBrush}"
                    Foreground="{StaticResource DangerTextBrush}"
                    Click="OnQuitClicked"
                    Content="Quit" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
