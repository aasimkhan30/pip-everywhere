<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PiPEverywhere.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Padding="32,24,32,36" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Keep PiP with you" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Choose which browsers should carry their picture-in-picture window across all Windows virtual desktops."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="StatusIcon"
                        FontSize="22"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Name="StatusTitle"
                            FontWeight="SemiBold"
                            Text="Watching for picture-in-picture windows" />
                        <TextBlock
                            x:Name="StatusDetail"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No PiP windows pinned in this session" />
                    </StackPanel>
                    <ProgressRing
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        IsActive="True" />
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Browsers" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <CheckBox
                            x:Name="EdgeCheckBox"
                            Padding="16,12"
                            Checked="OnBrowserSelectionChanged"
                            Content="Microsoft Edge"
                            Tag="edge"
                            Unchecked="OnBrowserSelectionChanged" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <CheckBox
                            x:Name="ChromeCheckBox"
                            Padding="16,12"
                            Checked="OnBrowserSelectionChanged"
                            Content="Google Chrome"
                            Tag="chrome"
                            Unchecked="OnBrowserSelectionChanged" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <CheckBox
                            x:Name="FirefoxCheckBox"
                            Padding="16,12"
                            Checked="OnBrowserSelectionChanged"
                            Content="Mozilla Firefox"
                            Tag="firefox"
                            Unchecked="OnBrowserSelectionChanged" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <CheckBox
                            x:Name="BraveCheckBox"
                            Padding="16,12"
                            Checked="OnBrowserSelectionChanged"
                            Content="Brave"
                            Tag="brave"
                            Unchecked="OnBrowserSelectionChanged" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <CheckBox
                            x:Name="OperaCheckBox"
                            Padding="16,12"
                            Checked="OnBrowserSelectionChanged"
                            Content="Opera"
                            Tag="opera"
                            Unchecked="OnBrowserSelectionChanged" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <CheckBox
                            x:Name="VivaldiCheckBox"
                            Padding="16,12"
                            Checked="OnBrowserSelectionChanged"
                            Content="Vivaldi"
                            Tag="vivaldi"
                            Unchecked="OnBrowserSelectionChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Startup" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid Padding="16,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Start automatically when I sign in" />
                            <TextBlock
                                x:Name="StartupDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Starts quietly in the notification area."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Grid.Column="1"
                            OffContent=""
                            OnContent=""
                            Toggled="OnStartupToggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="PiP Everywhere only reads window titles and process names on this PC. It does not access browser tabs, history, or page content."
                Severity="Informational"
                Title="Runs locally" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    Click="OnHideToTrayClicked"
                    Content="Hide to tray" />
                <Button
                    Grid.Column="2"
                    Click="OnQuitClicked"
                    Content="Quit" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
